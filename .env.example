# Server Configuration
PORT=5002
NODE_ENV=development
CORS_ORIGIN=http://localhost:5175

# PostgreSQL (Relational Source of Truth)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=student_readiness

# Alternative local PostgreSQL cluster configuration (if port 5432 is password protected)
# PGPORT=5433

# MongoDB (Append-Only Operational Activity Store)
MONGODB_URI=mongodb://127.0.0.1:27017/student_readiness_operational

# JWT Authentication
JWT_SECRET=production_grade_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# Idempotency Retention
IDEMPOTENCY_TTL_HOURS=24
