{
  "name": "student-readiness-backend",
  "version": "1.0.0",
  "description": "Backend API for Student Readiness Control Center",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:domain": "jest tests/domain/ --runInBand",
    "test:integration": "jest tests/integration/ --runInBand",
    "test:idempotency": "jest tests/idempotency/ --runInBand",
    "test:failure-injection": "jest tests/integration/failureInjection.test.js --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.5.0",
    "pg": "^8.11.5",
    "student-readiness-control-center": "file:..",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "testTimeout": 15000
  }
}
